{
  "name": "nxt-root-deployment",
  "version": "1.0.0",
  "private": true,
  "description": "Root-level Node.js deployment for the LCPS GO portal and Scramjet proxy.",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "postinstall": "npm --prefix ./scramjet install",
    "start": "node server.js",
    "dev": "node server.js",
    "install:app": "npm --prefix ./scramjet install",
    "start:app": "node server.js"
  }
}
